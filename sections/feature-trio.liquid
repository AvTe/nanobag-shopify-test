{{ 'section-feature-trio.css' | asset_url | stylesheet_tag }}

<div
  class="feature-trio"
  style="
    --feature-trio-background: {{ section.settings.background_color }};
    --feature-trio-text: {{ section.settings.text_color }};
    --feature-trio-muted: {{ section.settings.label_color }};
    --feature-trio-icon-size: {{ section.settings.icon_size }}px;
    --feature-trio-padding-top: {{ section.settings.padding_top }}px;
    --feature-trio-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="feature-trio__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="feature-trio__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="feature-trio__grid" role="list">
        {%- for block in section.blocks -%}
          <li class="feature-trio__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              {{
                block.settings.icon
                | image_url: width: 240
                | image_tag:
                  class: 'feature-trio__icon',
                  loading: 'lazy',
                  widths: '60, 120, 180, 240',
                  sizes: '80px',
                  alt: block.settings.icon_alt
              }}
            {%- endif -%}

            {%- if block.settings.value != blank -%}
              <p class="feature-trio__value">{{ block.settings.value | escape }}</p>
            {%- endif -%}

            {%- if block.settings.label != blank -%}
              <p class="feature-trio__label">{{ block.settings.label | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.supporting_text != blank -%}
      <div class="feature-trio__supporting rte">{{ section.settings.supporting_text }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Feature trio",
  "tag": "section",
  "class": "section-feature-trio",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. Renders as an h2. Leave empty to show only the stats."
    },
    {
      "type": "richtext",
      "id": "supporting_text",
      "label": "Supporting text",
      "default": "<p>Practical durable bags. Designed to disappear in your pocket.</p>"
    },
    { "type": "header", "content": "Appearance" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Value and heading colour", "default": "#121212" },
    { "type": "color", "id": "label_color", "label": "Label colour", "default": "#6b6b6b" },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 32, "max": 140, "step": 4, "unit": "px", "default": 76
    },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 16 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        {
          "type": "text",
          "id": "icon_alt",
          "label": "Icon alt text",
          "info": "Leave empty where the value and label already say everything the icon shows."
        },
        { "type": "text", "id": "value", "label": "Value", "default": "0.8 - 1.1 oz" },
        { "type": "text", "id": "label", "label": "Label", "default": "Ultralight" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature trio",
      "blocks": [
        { "type": "feature", "settings": { "value": "0.8 - 1.1 oz", "label": "Ultralight" } },
        { "type": "feature", "settings": { "value": "Compact", "label": "Design" } },
        { "type": "feature", "settings": { "value": "66 lb", "label": "Load rating" } }
      ]
    }
  ]
}
{% endschema %}
