{{ 'section-hero-video.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  The headline face is a font_picker rather than a Google Fonts link, so it is
  served from Shopify's own font CDN with no external request.

  font_face emits a bare @font-face rule, not a tag, so it has to sit inside a
  style block. This is the one place a style block is warranted: an @font-face
  cannot be expressed as a custom property in a static stylesheet. Dawn does
  the same thing in theme.liquid.
{%- endcomment -%}
{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.heading_font_mobile | font_face: font_display: 'swap' }}
{%- endstyle -%}

{%- liquid
  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
  assign heading_tag = section.settings.heading_tag | default: 'h1'
  assign cta_url = section.settings.cta_link | default: routes.all_products_collection_url

  # Shopify generates a preview image for every uploaded video, so a poster is
  # never mandatory. An explicit poster still wins where the merchant wants a
  # different frame or a different crop.
  assign desktop_poster = section.settings.poster_image | default: section.settings.video_desktop.preview_image
  assign mobile_poster = section.settings.poster_image_mobile | default: section.settings.video_mobile.preview_image
  assign mobile_poster = mobile_poster | default: desktop_poster

  assign badge_desktop = section.settings.badge_image
  assign badge_mobile = section.settings.badge_image_mobile | default: badge_desktop

  assign has_video = false
  if section.settings.video_desktop != blank or section.settings.video_mobile != blank
    assign has_video = true
  endif
-%}

{%- if has_video -%}
  <script src="{{ 'hero-video.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- comment -%}
  The overlay opacity, colour and section height are the only values that cannot
  be known at build time, so they are piped in as custom properties. Everything
  else lives in section-hero-video.css.
{%- endcomment -%}
<div
  class="hero-video hero-video--align-{{ section.settings.content_alignment }} hero-video--mobile-{{ section.settings.mobile_alignment }}"
  style="
    --hero-overlay-opacity: {{ overlay_alpha }};
    --hero-overlay-color: {{ section.settings.overlay_color }};
    --hero-height: {{ section.settings.section_height }}vh;
    --hero-cta-background: {{ section.settings.cta_background }};
    --hero-cta-text: {{ section.settings.cta_text_color }};
    --hero-mobile-ratio: {{ section.settings.mobile_media_ratio }};
    --hero-card-background: {{ section.settings.card_background }};
    --hero-card-text: {{ section.settings.card_text_color }};
    --hero-overlay-text: {{ section.settings.overlay_text_color }};
    --hero-cta-scale: {{ section.settings.cta_size | divided_by: 100.0 }};
    --hero-heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    --hero-heading-font-mobile: {{ section.settings.heading_font_mobile.family }}, {{ section.settings.heading_font_mobile.fallback_families }};
    --hero-overlay-opacity-mobile: {{ section.settings.overlay_opacity_mobile | divided_by: 100.0 }};
    --hero-badge-rotation: {{ section.settings.badge_rotation }}deg;
    --hero-media-radius-desktop: {{ section.settings.media_radius_desktop }}px;
    --hero-heading-weight: {{ section.settings.heading_font.weight }};
    --hero-badge-size-mobile: {{ section.settings.badge_size_mobile }}px;
    --hero-media-radius: {{ section.settings.mobile_media_radius }}px;
  "
>
  <div class="hero-video__media">
    {%- comment -%}
      The poster is the LCP element: eager, high priority, responsive. A
      <picture> swaps the crop at the breakpoint natively, which keeps this to
      one element and no JavaScript. It is decorative, so alt is intentionally
      empty: the heading carries the meaning.
    {%- endcomment -%}
    {%- if desktop_poster != blank -%}
      <picture class="hero-video__picture">
        {%- if mobile_poster != desktop_poster -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_poster | image_url: width: 600 }} 600w,
              {{ mobile_poster | image_url: width: 900 }} 900w,
              {{ mobile_poster | image_url: width: 1200 }} 1200w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{
          desktop_poster
          | image_url: width: 1920
          | image_tag:
            class: 'hero-video__poster',
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '100vw',
            widths: '640, 960, 1280, 1600, 1920',
            alt: ''
        }}
      </picture>
    {%- endif -%}

    {%- comment -%}
      Each video sits in an inert <template>, so only the one matching the
      viewport is ever fetched. See assets/hero-video.js.

      image_size is deliberately omitted so Shopify emits no poster attribute on
      the video. The video then paints transparent until its first frame, which
      lets the poster image show through underneath, with no cross-fade script.
    {%- endcomment -%}
    {%- if has_video -%}
      <responsive-video class="hero-video__player" data-breakpoint="750">
        {%- if section.settings.video_mobile != blank -%}
          <template data-viewport="mobile">
            {{
              section.settings.video_mobile
              | video_tag:
                class: 'hero-video__media-video',
                autoplay: true,
                loop: true,
                muted: true,
                controls: false,
                playsinline: true,
                preload: 'metadata'
            }}
          </template>
        {%- endif -%}
        {%- if section.settings.video_desktop != blank -%}
          <template data-viewport="desktop">
            {{
              section.settings.video_desktop
              | video_tag:
                class: 'hero-video__media-video',
                autoplay: true,
                loop: true,
                muted: true,
                controls: false,
                playsinline: true,
                preload: 'metadata'
            }}
          </template>
        {%- endif -%}
      </responsive-video>
    {%- endif -%}

    <div class="hero-video__overlay" aria-hidden="true"></div>
  </div>

  <div class="hero-video__inner">
    <div class="hero-video__content">
      {%- comment -%}
        A <picture> swaps the badge lockup at the breakpoint natively. One
        element, one alt, no duplicated node and no script.
      {%- endcomment -%}
      {%- if badge_desktop != blank -%}
        <picture class="hero-video__badge">
          {%- if badge_mobile != badge_desktop -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ badge_mobile | image_url: width: 160 }} 160w,
                {{ badge_mobile | image_url: width: 240 }} 240w,
                {{ badge_mobile | image_url: width: 320 }} 320w
              "
              sizes="{{ section.settings.badge_size_mobile }}px"
            >
          {%- endif -%}
          {{
            badge_desktop
            | image_url: width: 320
            | image_tag:
              class: 'hero-video__badge-image',
              loading: 'eager',
              widths: '160, 240, 320',
              sizes: '(min-width: 750px) 110px, 88px',
              alt: section.settings.badge_alt
          }}
        </picture>
      {%- endif -%}

      {%- if section.settings.rating_text != blank -%}
        <p class="hero-video__rating">
          {%- render 'star-rating', rating: section.settings.rating_value, class: 'hero-video__stars' -%}
          <span class="hero-video__rating-text">{{ section.settings.rating_text }}</span>
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} class="hero-video__heading">{{ section.settings.heading }}</{{ heading_tag }}>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="hero-video__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.cta_text != blank -%}
        <a class="hero-video__cta" href="{{ cta_url }}">{{ section.settings.cta_text | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero video",
  "tag": "section",
  "class": "section-hero-video",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "video",
      "id": "video_desktop",
      "label": "Desktop background video",
      "info": "Shown at 750px and wider. Muted and looping."
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Mobile background video",
      "info": "Shown below 750px. Only the matching video is downloaded, so keep this file small."
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Desktop poster image",
      "info": "Optional. Falls back to the desktop video's own preview image."
    },
    {
      "type": "image_picker",
      "id": "poster_image_mobile",
      "label": "Mobile poster image",
      "info": "Optional. Use a portrait crop. Falls back to the mobile video's preview image, then the desktop poster."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 20,
      "info": "Figma uses 20% on the desktop frame. Keep body text at 4.5:1 over the poster."
    },
    {
      "type": "range",
      "id": "overlay_opacity_mobile",
      "label": "Image overlay opacity (small screens)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0,
      "info": "The mobile frame has no overlay, because the copy sits below the media rather than on it."
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay colour",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section height",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 90
    },
    {
      "type": "select",
      "id": "mobile_media_ratio",
      "label": "Mobile media shape",
      "options": [
        {
          "value": "3 / 4",
          "label": "Portrait (3:4)"
        },
        {
          "value": "4 / 5",
          "label": "Tall portrait (4:5)"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "16 / 9",
          "label": "Landscape (16:9)"
        }
      ],
      "default": "3 / 4",
      "info": "Height of the media on small screens, where the copy sits in a card below it."
    },
    {
      "type": "range",
      "id": "mobile_media_radius",
      "label": "Mobile media corner radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 30,
      "info": "Rounds the top corners of the video on small screens."
    },
    {
      "type": "range",
      "id": "media_radius_desktop",
      "label": "Media corner radius (large screens)",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Badge and rating"
    },
    {
      "type": "image_picker",
      "id": "badge_image",
      "label": "Award badge"
    },
    {
      "type": "image_picker",
      "id": "badge_image_mobile",
      "label": "Award badge (small screens)",
      "info": "Optional. The mobile frame uses a different lockup. Falls back to the badge above."
    },
    {
      "type": "text",
      "id": "badge_alt",
      "label": "Badge alt text",
      "default": "Nomads Nation Best Tote 2025"
    },
    {
      "type": "range",
      "id": "badge_size_mobile",
      "label": "Badge size on small screens",
      "min": 48,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 92
    },
    {
      "type": "range",
      "id": "badge_rotation",
      "label": "Badge rotation on small screens",
      "min": -30,
      "max": 30,
      "step": 1,
      "unit": "deg",
      "default": 15
    },
    {
      "type": "range",
      "id": "rating_value",
      "label": "Star rating",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "default": 4.8,
      "info": "Fills the stars. Shopify caps range defaults at one decimal, so the caption below carries the exact figure."
    },
    {
      "type": "inline_richtext",
      "id": "rating_text",
      "label": "Rating caption",
      "default": "<strong>4.8</strong> stars • <strong>200k+</strong> customers",
      "info": "Bold the numbers to match the design."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Headline font (large screens)",
      "default": "inter_n7",
      "info": "Figma uses Inter SemiBold on the desktop frame."
    },
    {
      "type": "font_picker",
      "id": "heading_font_mobile",
      "label": "Headline font (small screens)",
      "default": "fraunces_n7",
      "info": "Figma uses Fraunces on the mobile frame, with the second word italicised."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Extreme practicality",
      "info": "Wrap a word in italics if you want the accent treatment."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        }
      ],
      "default": "h1",
      "info": "Use H1 only when this section is the top of the page. One H1 per page."
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Supporting text",
      "default": "Zero bulk, Maximum Carry."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button label",
      "default": "Get Nanobag"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Defaults to the all products collection when empty."
    },
    {
      "type": "color",
      "id": "cta_background",
      "label": "Button background",
      "default": "#cc253e"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "cta_size",
      "label": "Button size",
      "min": 80,
      "max": 180,
      "step": 5,
      "unit": "%",
      "default": 125,
      "info": "Scales padding and label together. The 44px minimum tap target is kept at any value."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "overlay_text_color",
      "label": "Desktop copy colour",
      "default": "#ffffff",
      "info": "Used where the copy sits over the video."
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Mobile card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Mobile card text",
      "default": "#121212"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Desktop content position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "Mobile content position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "Hero video"
    }
  ]
}
{% endschema %}
