{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{{ 'section-video-gallery.css' | asset_url | stylesheet_tag }}

<div
  class="video-gallery video-gallery--visibility-{{ section.settings.visibility }}"
  style="
    --video-gallery-background: {{ section.settings.background_color }};
    --video-gallery-text: {{ section.settings.text_color }};
    --video-gallery-cta-background: {{ section.settings.cta_background }};
    --video-gallery-cta-text: {{ section.settings.cta_text_color }};
    --video-gallery-ratio: {{ section.settings.media_ratio }};
    --video-gallery-card: {{ section.settings.card_width }}%;
    --video-gallery-card-radius: {{ section.settings.card_radius }}px;
    --video-gallery-play-size: {{ section.settings.play_size }}px;
    --video-gallery-cta-width: {{ section.settings.cta_width }}%;
    --video-gallery-cta-border: {{ section.settings.cta_border }};
    --video-gallery-padding-top: {{ section.settings.padding_top }}px;
    --video-gallery-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="video-gallery__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="video-gallery__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="video-gallery__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign video = block.settings.video
            assign poster = block.settings.poster_image | default: video.preview_image
            assign label = block.settings.video_alt | default: video.alt
          -%}
          <li class="video-gallery__item" {{ block.shopify_attributes }}>
            {%- comment -%}
              Dawn's own deferred-media element is reused rather than writing a
              new custom element. It already does exactly what is needed here,
              including pausing any other playing media, and it is defined in
              global.js which every page loads. Reusing it means this section
              adds no JavaScript at all.

              The video markup lives in a <template>, which the browser does not
              fetch. That is what makes the facade genuinely free rather than
              only visually deferred.
            {%- endcomment -%}
            <deferred-media class="video-gallery__media deferred-media">
              <button
                id="Deferred-Poster-{{ block.id }}"
                class="video-gallery__poster deferred-media__poster"
                type="button"
                aria-label="{{ 'sections.video.load_video' | t: description: label }}"
              >
                {%- if poster != blank -%}
                  {{
                    poster
                    | image_url: width: 800
                    | image_tag:
                      class: 'video-gallery__image',
                      loading: 'lazy',
                      widths: '200, 400, 600, 800',
                      sizes: '(min-width: 750px) 240px, 60vw',
                      alt: ''
                  }}
                {%- else -%}
                  {{ 'hero-apparel-1' | placeholder_svg_tag: 'video-gallery__image placeholder-svg' }}
                {%- endif -%}
                <span class="deferred-media__poster-button motion-reduce">
                  <span class="svg-wrapper">{{- 'icon-play.svg' | inline_asset_content -}}</span>
                </span>
              </button>

              <template>
                {%- if video != blank -%}
                  {{
                    video
                    | video_tag:
                      class: 'video-gallery__video',
                      autoplay: true,
                      loop: block.settings.enable_looping,
                      muted: false,
                      controls: true,
                      playsinline: true
                  }}
                {%- endif -%}
              </template>
            </deferred-media>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.cta_text != blank -%}
      <a
        class="video-gallery__cta"
        href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}"
      >
        {{- section.settings.cta_text | escape -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Video gallery",
  "tag": "section",
  "class": "section-video-gallery",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "visibility",
      "label": "Show this section on",
      "options": [
        {
          "value": "all",
          "label": "All screens"
        },
        {
          "value": "small",
          "label": "Small screens only"
        },
        {
          "value": "large",
          "label": "Large screens only"
        }
      ],
      "default": "all",
      "info": "The supplied desktop frame contains only the hero and the logo bar, so this section is set to small screens."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See it in action"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button label",
      "default": "Choose your Nanobag"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Defaults to the all products collection when empty."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Video shape",
      "options": [
        {
          "value": "2 / 3",
          "label": "Card (2:3)"
        },
        {
          "value": "9 / 16",
          "label": "Vertical (9:16)"
        },
        {
          "value": "3 / 4",
          "label": "Portrait (3:4)"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        }
      ],
      "default": "2 / 3"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width",
      "min": 30,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 49,
      "info": "Share of the row each card takes. Lower values show more of the neighbouring cards."
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "play_size",
      "label": "Play button size",
      "min": 40,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading colour",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "cta_background",
      "label": "Button background",
      "default": "#cc253e"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "cta_width",
      "label": "Button width",
      "min": 40,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 84
    },
    {
      "type": "color",
      "id": "cta_border",
      "label": "Button border",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "video_item",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "image_picker",
          "id": "poster_image",
          "label": "Custom thumbnail",
          "info": "Optional. Falls back to the video's own preview image."
        },
        {
          "type": "text",
          "id": "video_alt",
          "label": "Video description",
          "info": "Used in the play button's accessible name, for example \"Nanobag folded into its pouch\"."
        },
        {
          "type": "checkbox",
          "id": "enable_looping",
          "label": "Loop video",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video gallery",
      "blocks": [
        {
          "type": "video_item"
        },
        {
          "type": "video_item"
        },
        {
          "type": "video_item"
        },
        {
          "type": "video_item"
        }
      ]
    }
  ]
}
{% endschema %}
