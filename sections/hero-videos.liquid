{%- comment -%}
  ---------------------------------------------------------------------------
  Section: Hero video
  ---------------------------------------------------------------------------
  Single markup tree, two layouts.

  Desktop  : content overlays the video (CSS grid single-cell stack)
  Mobile   : content drops into a white rounded card below the video
  Badge    : one node, repositioned absolutely on mobile over the media
  Overlay  : opacity driven by a CSS custom property, 0 to 100 from the editor

  Media art direction:
  Poster uses <picture> with a media source, so the browser downloads exactly
  one image. Video cannot do the same, because the `media` attribute on
  <source> is only honoured inside <picture>, not <video>. A ~35 line custom
  element resolves the correct source once and assigns it, so nothing is
  fetched for the breakpoint you are not on, and nothing is fetched at all
  under prefers-reduced-motion.

  No libraries. Posters render without JS, so the section degrades cleanly.
  ---------------------------------------------------------------------------
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign rating_pct = s.rating_value | times: 20.0
  assign heading_tag = s.heading_tag | default: 'h1'

  assign cta_label_mobile = s.cta_text_mobile | default: s.cta_text
  assign has_mobile_label = false
  if s.cta_text_mobile != blank and s.cta_text_mobile != s.cta_text
    assign has_mobile_label = true
  endif

  assign badge_desktop = s.badge_image_desktop | default: s.badge_image_mobile
  assign badge_mobile = s.badge_image_mobile | default: s.badge_image_desktop

  comment
    Posters. Each falls back to the other when only one is supplied.
  endcomment
  assign poster_desktop = s.poster_image | default: s.poster_image_mobile
  assign poster_mobile = s.poster_image_mobile | default: s.poster_image

  comment
    Videos. Mobile falls back to the desktop video when not supplied.
  endcomment
  assign video_desktop = s.hero_video
  assign video_mobile = s.hero_video_mobile | default: s.hero_video

  assign mobile_cap = s.mobile_source_cap | plus: 0

  comment
    Resolve the largest mp4 rendition for desktop, and the largest rendition
    at or below the cap for mobile. When only one video is supplied, this
    alone saves a meaningful download on phones.
  endcomment
  assign desktop_src = ''
  assign desktop_w = 0
  if video_desktop != blank
    for src in video_desktop.sources
      if src.format == 'mp4' and src.width > desktop_w
        assign desktop_w = src.width
        assign desktop_src = src.url
      endif
    endfor
  endif

  assign mobile_src = ''
  assign mobile_w = 0
  if video_mobile != blank
    for src in video_mobile.sources
      if src.format == 'mp4' and src.width > mobile_w and src.width <= mobile_cap
        assign mobile_w = src.width
        assign mobile_src = src.url
      endif
    endfor

    comment
      Nothing under the cap: fall back to the smallest available rendition.
    endcomment
    if mobile_src == blank
      assign smallest = 999999
      for src in video_mobile.sources
        if src.format == 'mp4' and src.width < smallest
          assign smallest = src.width
          assign mobile_src = src.url
        endif
      endfor
    endif
  endif

  comment
    Mobile media box. Either a fixed viewport height or the true aspect ratio
    of the mobile asset, which matters when that footage is vertical.
  endcomment
  assign mobile_ratio = 0
  if video_mobile != blank and video_mobile.aspect_ratio > 0
    assign mobile_ratio = video_mobile.aspect_ratio
  elsif poster_mobile != blank
    assign mobile_ratio = poster_mobile.aspect_ratio
  endif
  if mobile_ratio == 0
    assign mobile_ratio = 0.8
  endif

  assign has_video = false
  if desktop_src != blank or mobile_src != blank
    assign has_video = true
  endif
-%}

<section
  class="nb-hero nb-hero--align-{{ s.content_alignment }} nb-hero--m-align-{{ s.mobile_alignment }} nb-hero--m-size-{{ s.mobile_media_sizing }}{% if s.overlap_header %} nb-hero--overlap{% endif %}"
  style="
    --nb-overlay-color: {{ s.overlay_color }};
    --nb-overlay-opacity: {{ s.overlay_opacity | divided_by: 100.0 }};
    --nb-overlay-opacity-m: {{ s.overlay_opacity_mobile | divided_by: 100.0 }};
    --nb-accent: {{ s.accent_color }};
    --nb-accent-hover: {{ s.accent_color_hover }};
    --nb-star: {{ s.star_color }};
    --nb-h-desktop: {{ s.height_desktop }}svh;
    --nb-media-h-mobile: {{ s.height_mobile }}svh;
    --nb-media-ratio-mobile: {{ mobile_ratio }};
    --nb-header-h: {{ s.header_height }}px;
    --nb-panel-radius: {{ s.panel_radius }}px;
    --nb-heading-measure: {{ s.heading_measure }}ch;
    --nb-focal: {{ s.focal_x }}% {{ s.focal_y }}%;
    --nb-focal-m: {{ s.focal_x_mobile }}% {{ s.focal_y_mobile }}%;
  "
>
  <div class="nb-hero__media">
    {%- if poster_desktop != blank or poster_mobile != blank -%}
      <picture class="nb-hero__poster-wrap">
        {%- if poster_desktop != blank -%}
          <source
            media="(min-width: 750px)"
            srcset="
              {{ poster_desktop | image_url: width: 960 }} 960w,
              {{ poster_desktop | image_url: width: 1200 }} 1200w,
              {{ poster_desktop | image_url: width: 1440 }} 1440w,
              {{ poster_desktop | image_url: width: 1680 }} 1680w,
              {{ poster_desktop | image_url: width: 1920 }} 1920w,
              {{ poster_desktop | image_url: width: 2400 }} 2400w
            "
            sizes="100vw"
            width="{{ poster_desktop.width }}"
            height="{{ poster_desktop.height }}"
          >
        {%- endif -%}
        <img
          class="nb-hero__poster"
          src="{{ poster_mobile | image_url: width: 900 }}"
          srcset="
            {{ poster_mobile | image_url: width: 480 }} 480w,
            {{ poster_mobile | image_url: width: 640 }} 640w,
            {{ poster_mobile | image_url: width: 828 }} 828w,
            {{ poster_mobile | image_url: width: 1080 }} 1080w,
            {{ poster_mobile | image_url: width: 1400 }} 1400w
          "
          sizes="100vw"
          width="{{ poster_mobile.width }}"
          height="{{ poster_mobile.height }}"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        >
      </picture>
    {%- endif -%}

    {%- if has_video -%}
      <nb-responsive-video
        class="nb-hero__video-host"
        data-desktop-src="{{ desktop_src | escape }}"
        data-mobile-src="{{ mobile_src | escape }}"
        data-breakpoint="750"
      >
        <video
          class="nb-hero__video"
          autoplay
          muted
          loop
          playsinline
          disablepictureinpicture
          disableremoteplayback
          preload="none"
          tabindex="-1"
          aria-hidden="true"
        ></video>
      </nb-responsive-video>

      <noscript>
        <video
          class="nb-hero__video nb-hero__video--noscript"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          tabindex="-1"
          aria-hidden="true"
          src="{{ desktop_src | default: mobile_src }}"
        ></video>
      </noscript>
    {%- endif -%}

    <div class="nb-hero__overlay" aria-hidden="true"></div>
  </div>

  <div class="nb-hero__panel">
    <div class="nb-hero__inner">
      {%- if badge_desktop != blank or badge_mobile != blank -%}
        <picture class="nb-hero__badge">
          {%- if badge_desktop != blank -%}
            <source
              media="(min-width: 750px)"
              srcset="
                {{ badge_desktop | image_url: width: 200 }} 1x,
                {{ badge_desktop | image_url: width: 400 }} 2x
              "
              width="{{ badge_desktop.width }}"
              height="{{ badge_desktop.height }}"
            >
          {%- endif -%}
          <img
            src="{{ badge_mobile | image_url: width: 200 }}"
            srcset="{{ badge_mobile | image_url: width: 200 }} 1x, {{ badge_mobile | image_url: width: 400 }} 2x"
            width="{{ badge_mobile.width }}"
            height="{{ badge_mobile.height }}"
            alt="{{ s.badge_alt | escape }}"
            loading="eager"
            decoding="async"
          >
        </picture>
      {%- endif -%}

      {%- if s.rating_text != blank or s.show_stars -%}
        <p class="nb-hero__rating">
          {%- if s.show_stars -%}
            <span
              class="nb-hero__stars"
              role="img"
              aria-label="{{ 'Rated ' | append: s.rating_value | append: ' out of 5 stars' | escape }}"
            >
              <span class="nb-hero__stars-track" aria-hidden="true">
                {%- for i in (1..5) -%}
                  <svg class="nb-hero__star" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M12 2.4l2.94 5.96 6.58.96-4.76 4.64 1.12 6.55L12 17.42l-5.88 3.09 1.12-6.55L2.48 9.32l6.58-.96L12 2.4z"/></svg>
                {%- endfor -%}
              </span>
              <span class="nb-hero__stars-fill" style="width: {{ rating_pct }}%" aria-hidden="true">
                {%- for i in (1..5) -%}
                  <svg class="nb-hero__star" viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M12 2.4l2.94 5.96 6.58.96-4.76 4.64 1.12 6.55L12 17.42l-5.88 3.09 1.12-6.55L2.48 9.32l6.58-.96L12 2.4z"/></svg>
                {%- endfor -%}
              </span>
            </span>
          {%- endif -%}

          {%- if s.rating_text != blank -%}
            <span class="nb-hero__rating-text">{{ s.rating_text }}</span>
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <{{ heading_tag }} class="nb-hero__heading">{{ s.heading }}</{{ heading_tag }}>
      {%- endif -%}

      {%- if s.subheading != blank -%}
        <p class="nb-hero__subheading{% unless s.show_subheading_mobile %} nb-hero__subheading--desktop-only{% endunless %}">
          {{ s.subheading }}
        </p>
      {%- endif -%}

      {%- if s.cta_text != blank -%}
        <a
          class="nb-hero__cta"
          href="{{ s.cta_link | default: '#' }}"
          {% if s.cta_link == blank %}role="link" aria-disabled="true"{% endif %}
        >
          <span class="nb-hero__cta-label{% if has_mobile_label %} nb-hero__cta-label--desktop{% endif %}">
            {{- s.cta_text -}}
          </span>
          {%- if has_mobile_label -%}
            <span class="nb-hero__cta-label nb-hero__cta-label--mobile">{{ cta_label_mobile }}</span>
          {%- endif -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  /* =========================================================================
     Hero video
     Mobile first. Desktop layout is the media-query branch.
     ========================================================================= */

  .nb-hero {
    --nb-gutter: clamp(1.25rem, 0.6rem + 3vw, 4rem);
    display: grid;
    grid-template-areas:
      'media'
      'panel';
    grid-template-columns: 1fr;
    position: relative;
    isolation: isolate;
    background: #fff;
  }

  .nb-hero--overlap {
    margin-top: calc(-1 * var(--nb-header-h, 0px));
  }

  /* ---------- Media ---------------------------------------------------- */

  .nb-hero__media {
    grid-area: media;
    position: relative;
    overflow: hidden;
    background: #0d0d0d;
  }

  .nb-hero--m-size-fixed .nb-hero__media {
    height: var(--nb-media-h-mobile, 46svh);
    min-height: 17rem;
  }

  /* Vertical mobile footage: reserve the real box so there is zero CLS. */
  .nb-hero--m-size-ratio .nb-hero__media {
    aspect-ratio: var(--nb-media-ratio-mobile, 0.8);
    max-height: 78svh;
  }

  .nb-hero__poster-wrap {
    display: contents;
  }

  .nb-hero__poster,
  .nb-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--nb-focal-m, 50% 50%);
    display: block;
  }

  .nb-hero__video-host {
    position: absolute;
    inset: 0;
    display: block;
  }

  .nb-hero__video {
    z-index: 1;
    border: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  /* Revealed only once a frame is decodable, so the poster is never replaced
     by a black box mid-load. */
  nb-responsive-video[data-ready='true'] .nb-hero__video {
    opacity: 1;
  }

  .nb-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--nb-overlay-color, #000);
    opacity: var(--nb-overlay-opacity-m, 0.2);
    pointer-events: none;
  }

  /* ---------- Panel ---------------------------------------------------- */

  .nb-hero__panel {
    grid-area: panel;
    position: relative;
    z-index: 3;
    background: #fff;
    border-start-start-radius: var(--nb-panel-radius, 24px);
    border-start-end-radius: var(--nb-panel-radius, 24px);
    margin-top: calc(-1 * var(--nb-panel-radius, 24px));
    padding-block: clamp(1.5rem, 1rem + 3vw, 2.75rem) clamp(1.25rem, 1rem + 2vw, 2rem);
    padding-inline: var(--nb-gutter);
  }

  .nb-hero__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 0.5rem + 1.4vw, 1.25rem);
    max-width: 46rem;
    margin-inline: auto;
  }

  .nb-hero--m-align-center .nb-hero__inner {
    align-items: center;
    text-align: center;
  }

  .nb-hero--m-align-left .nb-hero__inner {
    align-items: flex-start;
    text-align: start;
  }

  /* ---------- Badge ----------------------------------------------------- */
  /* One node. Lifted out of the panel over the media on mobile, back into
     normal flow on desktop. */

  .nb-hero__badge {
    position: absolute;
    inset-block-start: calc(-1 * clamp(4.5rem, 3rem + 11vw, 7rem));
    inset-inline-end: var(--nb-gutter);
    z-index: 4;
    display: block;
    width: clamp(3.75rem, 2.5rem + 6vw, 5.5rem);
    line-height: 0;
  }

  .nb-hero__badge img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ---------- Rating ----------------------------------------------------- */

  .nb-hero__rating {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin: 0;
    font-size: clamp(0.75rem, 0.68rem + 0.35vw, 0.9375rem);
    line-height: 1.3;
    color: #1a1a1a;
  }

  .nb-hero__stars {
    position: relative;
    display: inline-block;
    line-height: 0;
    flex: none;
  }

  .nb-hero__stars-track,
  .nb-hero__stars-fill {
    display: flex;
    gap: 0.08em;
  }

  .nb-hero__stars-track {
    color: color-mix(in srgb, var(--nb-star, #f5a623) 26%, transparent);
  }

  .nb-hero__stars-fill {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    overflow: hidden;
    color: var(--nb-star, #f5a623);
  }

  .nb-hero__star {
    width: 1.05em;
    height: 1.05em;
    flex: none;
    fill: currentColor;
  }

  .nb-hero__rating-text {
    white-space: nowrap;
  }

  .nb-hero__rating-text strong,
  .nb-hero__rating-text b {
    font-weight: 600;
  }

  /* ---------- Heading ---------------------------------------------------- */

  .nb-hero__heading {
    margin: 0;
    max-width: var(--nb-heading-measure, 14ch);
    font-family: var(--font-heading-family, inherit);
    font-size: clamp(2rem, 1.1rem + 4.4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: #111;
    text-wrap: balance;
  }

  /* Mobile design mixes a bold grotesk with an italic serif.
     Merchant chooses the word by italicising it in the editor. */
  .nb-hero__heading em,
  .nb-hero__heading i {
    font-family: var(--nb-serif, 'Playfair Display', Georgia, 'Times New Roman', serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  /* ---------- Subheading -------------------------------------------------- */

  .nb-hero__subheading {
    margin: 0;
    max-width: 34ch;
    font-size: clamp(0.9375rem, 0.85rem + 0.4vw, 1.125rem);
    line-height: 1.5;
    color: #3a3a3a;
  }

  .nb-hero__subheading--desktop-only {
    display: none;
  }

  /* ---------- CTA --------------------------------------------------------- */

  .nb-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    min-height: 3rem;
    padding: 0.85em 2.25em;
    border-radius: 999px;
    background: var(--nb-accent, #cc253e);
    color: #fff;
    font-size: clamp(0.9375rem, 0.85rem + 0.4vw, 1.0625rem);
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    text-align: center;
    transition: background-color 0.18s ease, transform 0.18s ease;
  }

  .nb-hero__cta:hover {
    background: var(--nb-accent-hover, #b31d33);
  }

  .nb-hero__cta:active {
    transform: translateY(1px);
  }

  .nb-hero__cta:focus-visible {
    outline: 3px solid var(--nb-accent, #cc253e);
    outline-offset: 3px;
  }

  .nb-hero__cta-label--desktop {
    display: none;
  }

  .nb-hero__cta-label--mobile {
    display: inline;
  }

  /* =========================================================================
     Desktop: panel moves into the media cell as an overlay
     ========================================================================= */

  @media screen and (min-width: 750px) {
    .nb-hero {
      grid-template-areas: 'stack';
      grid-template-rows: minmax(var(--nb-h-desktop, 88svh), auto);
      background: transparent;
    }

    .nb-hero__media,
    .nb-hero__panel {
      grid-area: stack;
    }

    .nb-hero--m-size-fixed .nb-hero__media,
    .nb-hero--m-size-ratio .nb-hero__media {
      height: 100%;
      min-height: 0;
      aspect-ratio: auto;
      max-height: none;
    }

    .nb-hero__poster,
    .nb-hero__video {
      object-position: var(--nb-focal, 50% 50%);
    }

    .nb-hero__overlay {
      opacity: var(--nb-overlay-opacity, 0.4);
    }

    .nb-hero__panel {
      display: grid;
      align-content: center;
      background: transparent;
      border-radius: 0;
      margin-top: 0;
      padding-block: calc(var(--nb-header-h, 0px) + clamp(2rem, 1rem + 4vw, 4rem)) clamp(3rem, 2rem + 5vw, 7rem);
      padding-inline: var(--nb-gutter);
      pointer-events: none;
    }

    /* Re-enable pointing only on what is actually clickable */
    .nb-hero__panel a,
    .nb-hero__panel button {
      pointer-events: auto;
    }

    .nb-hero__inner {
      gap: clamp(1rem, 0.6rem + 1.2vw, 1.75rem);
      max-width: min(90rem, 100%);
      width: 100%;
    }

    .nb-hero--align-left .nb-hero__inner {
      align-items: flex-start;
      text-align: start;
    }

    .nb-hero--align-center .nb-hero__inner {
      align-items: center;
      text-align: center;
      max-width: 60rem;
    }

    .nb-hero__badge {
      position: static;
      width: clamp(6rem, 3rem + 7vw, 9.25rem);
      margin-block-end: clamp(0.25rem, 0.6vw, 0.75rem);
    }

    .nb-hero__rating {
      font-size: clamp(0.9375rem, 0.6rem + 0.75vw, 1.25rem);
      color: #fff;
    }

    .nb-hero__heading {
      font-size: clamp(2.75rem, 0.4rem + 5.4vw, 5.5rem);
      line-height: 0.98;
      color: #fff;
    }

    /* Desktop headline is a single typeface. Neutralise the serif italic so
       the same editor value renders correctly in both layouts. */
    .nb-hero__heading em,
    .nb-hero__heading i {
      font-family: inherit;
      font-style: inherit;
      font-weight: inherit;
      letter-spacing: inherit;
    }

    .nb-hero__subheading {
      font-size: clamp(1rem, 0.7rem + 0.7vw, 1.5rem);
      color: rgba(255, 255, 255, 0.92);
    }

    .nb-hero__subheading--desktop-only {
      display: block;
    }

    .nb-hero__cta {
      align-self: auto;
      min-height: clamp(3.25rem, 1.5rem + 3.4vw, 4.625rem);
      padding-inline: clamp(2rem, 0.5rem + 3.4vw, 3.5rem);
      font-size: clamp(1rem, 0.6rem + 0.85vw, 1.625rem);
      font-weight: 500;
    }

    .nb-hero__cta-label--desktop {
      display: inline;
    }

    .nb-hero__cta-label--mobile {
      display: none;
    }
  }

  @media screen and (min-width: 1600px) {
    .nb-hero__inner {
      max-width: 90rem;
      margin-inline: auto;
    }
  }

  /* =========================================================================
     Motion and forced colours
     ========================================================================= */

  @media (prefers-reduced-motion: reduce) {
    .nb-hero__video,
    .nb-hero__video-host {
      display: none;
    }

    .nb-hero__cta {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .nb-hero__overlay {
      display: none;
    }

    .nb-hero__cta {
      border: 2px solid currentColor;
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * <nb-responsive-video>
   *
   * Assigns one video source based on the viewport. The `media` attribute on
   * <source> is only honoured inside <picture>, so <video> cannot art-direct
   * declaratively. This resolves it once, swaps on a real breakpoint cross,
   * and skips loading entirely when reduced motion is requested.
   */
  if (!customElements.get('nb-responsive-video')) {
    customElements.define(
      'nb-responsive-video',
      class NbResponsiveVideo extends HTMLElement {
        connectedCallback() {
          this.video = this.querySelector('video');
          if (!this.video) return;

          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

          const bp = parseInt(this.dataset.breakpoint, 10) || 750;
          this.mq = window.matchMedia('(min-width: ' + bp + 'px)');

          this.markReady = () => {
            this.dataset.ready = 'true';
          };
          this.video.addEventListener('loadeddata', this.markReady);

          this.onChange = () => this.apply();
          this.mq.addEventListener('change', this.onChange);

          this.apply();
        }

        disconnectedCallback() {
          if (this.mq && this.onChange) this.mq.removeEventListener('change', this.onChange);
          if (this.video && this.markReady) this.video.removeEventListener('loadeddata', this.markReady);
        }

        apply() {
          const wanted = this.mq.matches
            ? this.dataset.desktopSrc || this.dataset.mobileSrc
            : this.dataset.mobileSrc || this.dataset.desktopSrc;

          if (!wanted || this.current === wanted) return;
          this.current = wanted;

          this.video.src = wanted;
          this.video.load();

          const started = this.video.play();
          if (started && typeof started.catch === 'function') {
            // Autoplay can be refused (low power mode, data saver).
            // The poster stays visible, so there is nothing to recover from.
            started.catch(function () {});
          }
        }
      }
    );
  }
{% endjavascript %}

{% schema %}
{
  "name": "Hero video",
  "tag": "section",
  "class": "section-nb-hero",
  "settings": [
    { "type": "header", "content": "Desktop media" },
    {
      "type": "video",
      "id": "hero_video",
      "label": "Background video (desktop)"
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Poster image (desktop)",
      "info": "Paints instantly before the video loads. This is the LCP element, so always set one."
    },
    {
      "type": "range",
      "id": "focal_x",
      "label": "Focal point X (desktop)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "focal_y",
      "label": "Focal point Y (desktop)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },

    { "type": "header", "content": "Mobile media" },
    {
      "type": "video",
      "id": "hero_video_mobile",
      "label": "Background video (mobile)",
      "info": "Optional. Leave empty to reuse the desktop video at a smaller rendition."
    },
    {
      "type": "image_picker",
      "id": "poster_image_mobile",
      "label": "Poster image (mobile)",
      "info": "Optional. Leave empty to reuse the desktop poster."
    },
    {
      "type": "select",
      "id": "mobile_media_sizing",
      "label": "Mobile media sizing",
      "options": [
        { "value": "fixed", "label": "Fixed height" },
        { "value": "ratio", "label": "Match video aspect ratio" }
      ],
      "default": "fixed",
      "info": "Choose aspect ratio when the mobile video is vertical, so nothing is cropped."
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Media height (mobile)",
      "min": 30,
      "max": 80,
      "step": 2,
      "unit": "vh",
      "default": 46,
      "info": "Used only with fixed height sizing."
    },
    {
      "type": "range",
      "id": "focal_x_mobile",
      "label": "Focal point X (mobile)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "focal_y_mobile",
      "label": "Focal point Y (mobile)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "select",
      "id": "mobile_source_cap",
      "label": "Max mobile video width",
      "options": [
        { "value": "720", "label": "720 px" },
        { "value": "1080", "label": "1080 px" },
        { "value": "1440", "label": "1440 px" }
      ],
      "default": "1080",
      "info": "Caps which rendition phones download. Lower is faster."
    },

    { "type": "header", "content": "Overlay" },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay colour",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity (desktop)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "range",
      "id": "overlay_opacity_mobile",
      "label": "Overlay opacity (mobile)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 20,
      "info": "Mobile copy sits on the white card, so the media usually needs less dimming."
    },

    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Section height (desktop)",
      "min": 60,
      "max": 100,
      "step": 2,
      "unit": "vh",
      "default": 88
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "Content position (mobile)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "panel_radius",
      "label": "Mobile card corner radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "overlap_header",
      "label": "Extend behind transparent header",
      "default": true
    },
    {
      "type": "range",
      "id": "header_height",
      "label": "Header height",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88,
      "info": "Pulls the section up behind a transparent header and pads the content clear of it."
    },

    { "type": "header", "content": "Badge" },
    {
      "type": "image_picker",
      "id": "badge_image_desktop",
      "label": "Badge (desktop)",
      "info": "Laurel award lockup. Sits above the rating."
    },
    {
      "type": "image_picker",
      "id": "badge_image_mobile",
      "label": "Badge (mobile)",
      "info": "Circular version. Floats over the top right of the video."
    },
    {
      "type": "text",
      "id": "badge_alt",
      "label": "Badge alt text",
      "default": "Nomads Nation Best Tote 2025"
    },

    { "type": "header", "content": "Rating" },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show star icons",
      "default": true
    },
    {
      "type": "range",
      "id": "rating_value",
      "label": "Rating out of 5",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "default": 4.8
    },
    {
      "type": "inline_richtext",
      "id": "rating_text",
      "label": "Rating caption",
      "default": "<strong>4.8 stars</strong> • <strong>200k+</strong> customers"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star colour",
      "default": "#F5A623"
    },

    { "type": "header", "content": "Content" },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Extreme <em>practicality</em>",
      "info": "Italicise a word to render it in the serif face on mobile. Desktop renders the whole heading in one typeface."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h1",
      "info": "Use H1 only when this is the first section on the page."
    },
    {
      "type": "range",
      "id": "heading_measure",
      "label": "Heading line length",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "ch",
      "default": 14,
      "info": "Controls where the heading wraps. Lower values force an earlier break."
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Supporting text",
      "default": "Zero bulk, Maximum Carry."
    },
    {
      "type": "checkbox",
      "id": "show_subheading_mobile",
      "label": "Show supporting text on mobile",
      "default": false
    },

    { "type": "header", "content": "Call to action" },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button label",
      "default": "Get Nanobag"
    },
    {
      "type": "text",
      "id": "cta_text_mobile",
      "label": "Button label (mobile)",
      "info": "Leave empty to reuse the desktop label.",
      "default": "Shop Nanobag"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button colour",
      "default": "#CC253E"
    },
    {
      "type": "color",
      "id": "accent_color_hover",
      "label": "Button colour on hover",
      "default": "#B31D33"
    }
  ],
  "presets": [
    {
      "name": "Hero video"
    }
  ]
}
{% endschema %}
