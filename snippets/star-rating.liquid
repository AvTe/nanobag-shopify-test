{%- comment -%}
  Accessible star rating.

  Renders two stacked rows of five stars: a muted track and a gold fill layer
  clipped to the rating percentage. This supports fractional ratings (4.8)
  without shipping half-star and quarter-star icon variants, and without any
  JavaScript.

  The whole unit is a single role="img" with one label, so a screen reader
  announces "Rated 4.8 out of 5 stars" instead of reading ten decorative shapes.

  Accepts:
  - rating: {Number} value out of 5
  - class:  {String} optional extra class on the wrapper
{%- endcomment -%}

{%- liquid
  assign rating_value = rating | default: 5
  assign fill_percent = rating_value | times: 20.0
-%}

<span
  class="star-rating {{ class }}"
  role="img"
  aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating_value, rating_max: 5 }}"
>
  <span class="star-rating__layer star-rating__layer--track" aria-hidden="true">
    {%- for i in (1..5) -%}
      {%- render 'icon-star' -%}
    {%- endfor -%}
  </span>
  <span class="star-rating__layer star-rating__layer--fill" style="width: {{ fill_percent }}%;" aria-hidden="true">
    {%- for i in (1..5) -%}
      {%- render 'icon-star' -%}
    {%- endfor -%}
  </span>
</span>
